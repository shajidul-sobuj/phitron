{"name":"Bazinga!","group":"beecrowd - Beginner","url":"https://judge.beecrowd.com/en/problems/view/1828","interactive":false,"memoryLimit":1024,"timeLimit":1000,"tests":[{"input":"3\npapel pedra\nlagarto tesoura\nSpock Spock\n","output":"Caso #1: Bazinga!\nCaso #2: Raj trapaceou!\nCaso #3: De novo!\n","id":1775134656772},{"id":1775134714549,"input":"// scissors cuts paper;\n// scissors decapitates lizard;\n\n// paper covers rock;\n// paper disproves Spock;\n\n// rock crushes lizard;\n// rock crushes scissors.\n\n// lizard poisons Spock;\n// lizard eats paper;\n\n// Spock smashes scissors;\n// Spock vaporizes rock;","output":"pedra, papel, tesoura, lagarto e Spock (rock, paper, scissors, lizard and Spock)."}],"testType":"single","input":{"type":"stdin"},"output":{"type":"stdout"},"languages":{"java":{"mainClass":"Main","taskClass":"Bazinga"}},"batch":{"id":"8811b73f-b139-4362-971f-45f092fccc52","size":1},"srcPath":"e:\\phitron\\bee\\Bazinga.cpp"}